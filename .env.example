PROMPTFIREWALL_ENV=development
PROMPTFIREWALL_DATABASE_URL=sqlite+aiosqlite:///./promptfirewall.db
PROMPTFIREWALL_MAX_MATRIX_SIZE=500
PROMPTFIREWALL_WORKER_COUNT=2
PROMPTFIREWALL_LOG_LEVEL=INFO

# Model adapter selection. The mock adapter is offline and is the CI default.
MODEL_PROVIDER=mock
MODEL_NAME=promptfirewall-mock-1
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=0.2
# MODEL_BASE_URL=
# MODEL_API_KEY=

# Uncomment one provider block and set MODEL_API_KEY in a local .env file.
# Groq
# MODEL_PROVIDER=groq
# MODEL_NAME=llama-3.3-70b-versatile
# MODEL_BASE_URL=https://api.groq.com/openai/v1
# MODEL_API_KEY=

# Gemini through Google's OpenAI-compatible endpoint
# MODEL_PROVIDER=gemini
# MODEL_NAME=gemini-2.0-flash
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MODEL_API_KEY=

# OpenRouter
